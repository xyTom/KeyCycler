{
  "name": "key-cycler",
  "version": "1.0.0",
  "description": "API Key Cycler with Cloudflare Workers KV",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create keycycler",
